# OpenRouter API key
# Get it at https://openrouter.ai
OPENROUTER_API_KEY=

# Model string — passed to OpenRouter
# DeepSeek via OpenRouter (cheap, reliable JSON mode, ~$0.14/1M tokens):
VEEN_AI_MODEL=deepseek/deepseek-v4-flash
# Step up to pro for more precise filtering: deepseek/deepseek-v4-pro

# Minimum relevance score to include an article (0.0–1.0)
VEEN_SCORE_THRESHOLD=0.4

# Articles per AI batch call
VEEN_BATCH_SIZE=25

# Freshness window — reject articles older than this at crawl time.
# Rolling hours, not calendar days: the 01:00 UTC crawl must still accept
# yesterday evening's news. Override per-source with max_age_days in sources.yaml.
VEEN_MAX_AGE_HOURS=72

# How long the crawler remembers a URL in data/state/seen.json
VEEN_SEEN_RETENTION_DAYS=90
